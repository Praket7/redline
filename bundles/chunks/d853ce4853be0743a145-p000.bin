</head><body>
<div id="rlBootCurtain" role="status" aria-label="Loading the REDLINE 3D hangar"><div class="rl-boot-inner"><div class="rl-boot-title">REDLINE</div><div class="rl-boot-rule"></div><div class="rl-boot-sub">PREPARING AIRCRAFT</div></div></div>
<div id="tp" class="p">LAP <b id="lp">1/3</b> · <b id="tm">0:00.0</b> · BEST <b id="bs">--</b><br><span id="sc"></span> · GATE <b id="gt"></b></div>
<div id="section">REDLINE // CANYON CLASH</div><div id="maphud"><canvas id="radar" width="380" height="380"></canvas><div class="lbl">COURSE NAV / <span id="gateName">ENTRY</span></div></div>
<div id="navPointer" class="hide">◇ NEXT GATE</div><div id="racePanel">PERSONAL BEST <b id="pb">--</b><br>MEDAL <b id="medal">NO MEDAL</b></div><div id="devStats" class="hide"></div><div id="speedMode">AFTERBURNER // BOOST</div><div id="routeHint"></div>
<div id="wd" class="p">WIND<br><span id="ar">➤</span><br><b id="ws">0</b> m/s</div>
<div id="sp" class="p"><b id="v">0</b> SPD · ALT <b id="al" style="font-size:16px">86</b> m</div>
<div id="bc" class="p"><div id="bar"><div id="bf"></div></div><span id="ls"></span></div>
<div id="set" class="p"><label>Thrust <input id="st" type="range" min="0" max="100" value="80"> <b id="nt">80</b></label><label>Agility <input id="sa" type="range" min="0" max="100" value="75"> <b id="na">75</b></label><label>Stability <input id="ss" type="range" min="0" max="100" value="70"> <b id="ns">70</b></label><label id="qualityControl">Graphics <select id="quality"><option value="performance">Performance</option><option value="balanced" selected>Balanced</option><option value="ultra">Ultra</option></select></label></div>
<div style="position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.2))"></div><div id="wet" style="position:fixed;inset:0;pointer-events:none;opacity:0;background:radial-gradient(ellipse at center,rgba(200,230,255,.05),rgba(190,220,255,.7))"></div><div id="msg"></div>
<div id="ov"><h1>REDLINE // CANYON CLASH</h1><p id="ot">Building canyon…</p></div>
<div id="rlShell">
 <div id="rlScreens" role="region" aria-label="REDLINE game menus"></div>
 <div id="rlPersistent" class="hidden" aria-label="Race HUD">
  <div id="rl70TieHud" aria-label="Copper Wraith live cockpit instruments"><div class="r70top"><span class="r70label">SPD</span><span class="r70value" id="rl70Speed">0</span><span class="r70unit">u/s</span></div><div class="r70middle"><div class="r70stat"><div class="r70label">ALT</div><div><span class="r70value" id="rl70Alt">0</span><span class="r70unit"> m</span></div></div><div class="r70reticle"></div><div class="r70stat"><div class="r70label">BOOST</div><div class="r70bars" id="rl70Bars"><i></i><i></i><i></i><i></i><i></i></div><span class="r70unit" id="rl70Boost">100%</span></div></div></div><img id="rl62TieOverlay" aria-hidden="true" alt="" decoding="sync" fetchpriority="high" src="data:image/webp;base64,