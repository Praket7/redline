">
  <div id="rlGameTop"><b id="rlPosition">4 / 4</b> <small>PLACE</small><div><span class="rl-lap-prefix">LAP</span><span class="rl-lap-count" aria-label="Current lap and total laps"><span id="rlLap">01</span><span id="rlLapTotal">/ 03</span></span><span id="rlRaceTime">0:00.0</span></div></div>
  <div id="rlGameButtons"><button data-op="controls" title="Learn controls without leaving the race" aria-expanded="false">? CONTROLS</button><button data-op="camera" title="Press P to switch view">P VIEW <span class="rl-view-caption" id="rlCameraMode">CHASE</span></button><button type="button" data-op="restartRun" title="Restart this run">↻ RESTART</button><button type="button" data-op="tutorial" title="Replay guided flight school">? FLIGHT SCHOOL</button><button data-op="settings" title="In-race settings" aria-expanded="false">⚙ SETTINGS</button></div>
  <div id="rlSprintTelemetry" aria-live="polite"><b id="rlSprintTitle">RAVEN SPRINT</b><span id="rlSprintSplit">4 GATES · BEAT YOUR RECORD</span><em id="rlSprintDelta">FIRST RUN</em></div><div id="rlReticle"><i></i></div><div id="rlAimHint">DOUBLE-CLICK TO FIRE · F ALSO FIRES</div>
  <div id="rlPositions" aria-label="Live race standings and time intervals"></div>
  <div id="rlSpeedBox" aria-label="Ground speed, altitude and boost">
 <div id="rlGaugeFrame"><svg id="rlSpeedDial" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
  <defs>
   <filter id="rlRedGlow" x="-70%" y="-70%" width="240%" height="240%"><feGaussianBlur stdDeviation="3"/></filter>
   <radialGradient id="rlGaugeFace"><stop offset="0%" stop-color="#1d0b11"/><stop offset="78%" stop-color="#09070a"/><stop offset="100%" stop-color="#060407"/></radialGradient>
  </defs>
  <circle cx="120" cy="120" r="113" class="rl-gauge-bezel"/>
  <circle cx="120" cy="120" r="108" class="rl-gauge-dial-bg"/>
  <circle cx="120" cy="120" r="94" pathLength="100" transform="rotate(132 120 120)" class="rl-gauge-track"/>
  <circle cx="120" cy="120" r="94" pathLength="100" transform="rotate(132 120 120)" stroke-dasharray="0 100" id="rlSpeedArcGlow" class="rl-gauge-progress glow"/>
  <circle cx="120" cy="120" r="94" pathLength="100" transform="rotate(132 120 120)" stroke-dasharray="0 100" id="rlSpeedArc" class="rl-gauge-progress"/>
  <g class="rl-gauge-ticks"><line x1="53.76" y1="193.57" x2="47.06" y2="201.00" class="major"/><line x1="42.13" y1="185.88" x2="39.08" y2="188.47" class="minor"/><line x1="33.95" y1="174.76" x2="30.57" y2="176.91" class="minor"/><line x1="27.34" y1="162.63" x2="23.70" y2="164.30" class="minor"/><line x1="25.30" y1="148.85" x2="15.73" y2="151.76" class="major"/><line x1="19.31" y1="136.27" x2="15.36" y2="136.90" class="minor"/><line x1="18.03" y1="122.51" x2="14.03" y2="122.61" class="minor"/><line x1="18.63" y1="108.71" x2="14.65" y2="108.27" class="minor"/><line x1="23.99" y1="95.85" x2="14.29" y2="93.41" class="major"/><line x1="25.35" y1="81.98" x2="21.64" y2="80.49" class="minor"/><line x1="31.35" y1="69.55" x2="27.88" y2="67.57" class="minor"/><line x1="38.98" y1="58.03" x2="35.81" y2="55.60" class="minor"/><line x1="50.21" y1="49.78" x2="43.16" y2="42.69" class="major"/><line x1="58.53" y1="38.60" x2="56.12" y2="35.41" class="minor"/><line x1="70.09" y1="31.04" x2="68.13" y2="27.56" class="minor"/><line x1="82.57" y1="25.12" x2="81.10" y2="21.40" class="minor"/><line x1="96.44" y1="23.84" x2="94.07" y2="14.13" class="major"/><line x1="109.34" y1="18.56" x2="108.92" y2="14.58" class="minor"/><line x1="123.14" y1="18.05" x2="123.26" y2="14.05" class="minor"/><line x1="136.89" y1="19.41" x2="137.55" y2="15.46" class="minor"/><line x1="149.43" y1="25.48" x2="152.40" y2="15.93" class="major"/><line x1="163.20" y1="27.60" x2="164.90" y2="23.98" class="minor"/><line x1="175.29" y1="34.28" x2="177.46" y2="30.92" class="minor"/><line x1="186.36" y1="42.54" x2="188.97" y2="39.50" class="minor"/><line x1="193.98" y1="54.21" x2="201.45" y2="47.57" class="major"/><line x1="204.68" y1="63.14" x2="208.00" y2="60.91" class="minor"/><line x1="211.58" y1="75.10" x2="215.18" y2="73.34" class="minor"/><line x1="216.81" y1="87.88" x2="220.61" y2="86.62" class="minor"/><line x1="217.31" y1="101.81" x2="227.14" y2="99.97" class="major"/><line x1="221.88" y1="114.98" x2="225.87" y2="114.78" class="minor"/><line x1="221.62" y1="128.79" x2="225.61" y2="129.13" class="minor"/><line x1="219.50" y1="142.43" x2="223.40" y2="143.31" class="minor"/><line x1="212.75" y1="154.62" x2="222.12" y2="158.12" class="major"/><line x1="209.86" y1="168.26" x2="213.39" y2="170.15" class="minor"/><line x1="200.09" y1="178.19" x2="208.18" y2="184.07" class="major"/></g>
  <g class="rl-gauge-labels"><text x="69.8" y="178.7" class="rl-gauge-mark">0</text><text x="48.7" y="99.8" class="rl-gauge-mark">85</text><text x="112.2" y="48.4" class="rl-gauge-mark">170</text><text x="185.0" y="85.5" class="rl-gauge-mark">255</text><text x="180.7" y="167.1" class="rl-gauge-mark">340</text></g>
  <g id="rlSpeedNeedle" transform="rotate(132 120 120)"><line x1="204" y1="120" x2="220" y2="120" class="rl-gauge-needle"/></g>
  <path d="M 55 204 Q 120 258 185 204" class="rl-boost-track" pathLength="100"/>
  <path id="rlBoostArc" d="M 55 204 Q 120 258 185 204" class="rl-boost-progress" pathLength="100" stroke-dasharray="100 100"/>
 </svg>
 <div class="rl-gauge-center"><span class="rl-gauge-caption">GROUND SPEED</span>
  <span id="rlSpeedValue">0</span><span class="rl-gauge-units">U / S</span><span class="rl-gauge-mode">FLIGHT</span></div>
 </div>
 <div id="rlSpeedFooter"><span>ALT <b id="rlAltValue">0</b> M</span><span>BOOST <b id="rlBoostValue">100%</b></span></div>
<div id="rlBoostLinear"><div class="rl-linear-label"><span>AFTERBURNER / SHIFT</span><b id="rlBoostStatus">READY</b></div><div class="rl-linear-rail"><i id="rlBoostLinearFill"></i></div><div class="rl-boost-key">HOLD SHIFT · RELEASE TO RECHARGE</div></div>
</div>
<div id="rlFpTelemetry" aria-label="First person altitude and boost"><div class="rl-fp-top"><span>ALTITUDE</span><strong><span id="rlFpAlt">0</span> M</strong></div><div class="rl-fp-top"><span>BOOST / SHIFT</span><strong id="rlFpBoost">100%</strong></div><div class="rl-linear-rail"><i id="rlFpBoostFill"></i></div></div>
<div id="rl61CockpitReadout" data-airframe="kestrel" aria-label="First person flight instrumentation"><div class="rl61-fpv-head"><b id="rl61FPVModel">KESTREL X4</b><span>FLIGHT SYSTEMS / LIVE</span></div><div class="rl61-fpv-grid"><div><small>SPEED</small><strong><span id="rl61FPVSpeed">0</span><em>U/S</em></strong></div><div><small>TURN RATE</small><strong id="rl61FPVTurn">0°/S</strong></div><div><small>HEADING</small><strong id="rl61FPVHeading">000°</strong></div><div><small>ALTITUDE</small><strong><span id="rl61FPVAlt">0</span><em>M</em></strong></div><div><small>BOOST LEFT</small><strong id="rl61FPVBoost">100%</strong></div></div><div class="rl61-fpv-rail"><i id="rl61FPVBoostFill"></i></div></div>
<div id="rlFlowModule" role="group" aria-label="Tactical Flow and combat abilities"><div class="rl-flow-top"><div><div class="rl-flow-name">TACTICAL <em>FLOW</em></div></div><div class="rl-flow-quantity"><span id="rlFlowCount">40</span><small>/100</small></div></div><div class="rl-flow-body"><div class="rl-flow-rail"><div id="rlFlowFill"></div></div><div class="rl-flow-help" id="rlFlowDescription">CLEAN GATES · NEAR MISSES · OVERTAKES</div><div class="rl-flow-actions"><button class="rl-flow-action" data-flow-action="refuel" title="B · Spend 25 Flow to refill the afterburner"><span class="key">B</span><span class="label">BOOST</span><span class="cost">25 FLOW</span></button><button class="rl-flow-action" data-flow-action="shield" title="J · Spend 24 Flow on a defensive shield"><span class="key">J</span><span class="label">SHIELD</span><span class="cost">24 FLOW</span></button><button class="rl-flow-action" data-flow-action="pulse" title="H · Spend 42 Flow on a rival-disrupting EMP"><span class="key">H</span><span class="label">EMP PULSE</span><span class="cost">42 FLOW</span></button><button class="rl-flow-action" data-flow-action="reload" title="Z · Spend 30 Flow to reload all laser charges"><span class="key">Z</span><span class="label">LASER LOAD</span><span class="cost">30 FLOW</span></button></div><div class="rl-flow-ammo"><span>LASER CELLS</span><span id="rlAmmoCharges">◆◆◆</span></div></div></div>
<div id="rlRaceShade" aria-hidden="true"></div>
<section id="rlRaceControlsPanel" class="rl-race-modal" role="dialog" aria-label="In-race controls" aria-modal="true"><div class="rl-modal-heading"><div><span class="rl-modal-kicker">PILOT TRAINING / RACE PAUSED</span><div class="rl-modal-title">FLIGHT CONTROLS</div><p class="rl-modal-sub">The canyon remains visible. Resume exactly where you stopped.</p></div><button class="rl-modal-close" data-op="closePanel" aria-label="Close controls">×</button></div><div class="rl-control-grid-live"><div class="rl-control-pair"><span>Accelerate / reverse</span><strong>W / S</strong></div><div class="rl-control-pair"><span>Steer / pitch (nose)</span><strong>MOVE MOUSE</strong></div><div class="rl-control-pair"><span>Strafe left / right</span><strong>A / D</strong></div><div class="rl-control-pair"><span>Optional climb / descend</span><strong>E / Q</strong></div><div class="rl-control-pair"><span>Fire laser</span><strong>DOUBLE-CLICK / F</strong></div><div class="rl-control-pair"><span>Boost</span><strong>SHIFT</strong></div><div class="rl-control-pair"><span>Flow → boost</span><strong>B · 25</strong></div><div class="rl-control-pair"><span>Energy shield</span><strong>J · 24</strong></div><div class="rl-control-pair"><span>EMP pulse</span><strong>H · 42</strong></div><div class="rl-control-pair"><span>Flow → laser refill</span><strong>Z · 30</strong></div><div class="rl-control-pair"><span>Recover at checkpoint</span><strong>R</strong></div><div class="rl-control-pair"><span>Change camera</span><strong>P</strong></div><div class="rl-control-pair"><span>Release pointer / close panel</span><strong>ESC</strong></div><div class="rl-control-pair"><span>Level nose / center reticle</span><strong>X / TAB</strong></div><div class="rl-control-pair"><span>Air brake</span><strong>SPACE</strong></div></div></section>
<section id="rlRaceSettingsPanel" class="rl-race-modal" role="dialog" aria-label="In-race settings" aria-modal="true"><div class="rl-modal-heading"><div><span class="rl-modal-kicker">FLIGHT SYSTEMS / RACE PAUSED</span><div class="rl-modal-title">SETTINGS</div><p class="rl-modal-sub">Changes apply instantly; your race progress is preserved.</p></div><button class="rl-modal-close" data-op="closePanel" aria-label="Close settings">×</button></div><div class="rl-setting-grid-live">
<div class="rl-live-setting rl-mode-setting"><label for="rlRaceHandlingMode">FLIGHT HANDLING</label><select id="rlRaceHandlingMode"><option value="easy">EASY · SMOOTH & SLOW</option><option value="sport">SPORT · QUICK</option><option value="expert">EXPERT · ORIGINAL SPEED</option></select><small>Easy limits top speed, smooths turns and helps you brake through corners.</small></div>
<div class="rl-live-setting"><label for="rlRaceBrightness">SCENE BRIGHTNESS <output id="rlRaceBrightnessOut">100%</output></label><input id="rlRaceBrightness" type="range" min="65" max="145" value="100"></div>
<div class="rl-live-setting"><label for="rlRaceVolume">MASTER VOLUME <output id="rlRaceVolumeOut">70%</output></label><input id="rlRaceVolume" type="range" min="0" max="100" value="70"></div>
<div class="rl-live-setting"><label for="rlRaceSensitivity">MOUSE SENSITIVITY <output id="rlRaceSensitivityOut">50%</output></label><input id="rlRaceSensitivity" type="range" min="15" max="100" value="50"></div>
<div class="rl-live-setting"><label for="rlRacePitchSensitivity">PITCH SENSITIVITY <output id="rlRacePitchSensitivityOut">90%</output></label><input id="rlRacePitchSensitivity" type="range" min="30" max="180" value="90"></div>
<div class="rl-live-setting"><label for="rlRaceMouseControlMode">MOUSE FLIGHT MODE</label><select id="rlRaceMouseControlMode"><option value="locked">LOCKED FLIGHT (DEFAULT)</option><option value="classic">CLASSIC RIGHT-DRAG</option></select></div>
<div class="rl-live-setting"><label for="rlRaceCenteredAim">CENTERED RETICLE <input id="rlRaceCenteredAim" type="checkbox" checked></label></div>
<div class="rl-live-setting"><label for="rlRaceAutoPointerLock">LOCK ON RACE START <input id="rlRaceAutoPointerLock" type="checkbox" checked></label></div>
<div class="rl-live-setting"><label for="rlRaceHudSize">HUD SIZE</label><select id="rlRaceHudSize"><option value="normal">STANDARD</option><option value="large">LARGE</option></select></div><div class="rl-live-setting rl-hud-profile-control"><label for="rlRaceHudMode">RACE HUD PROFILE</label><select id="rlRaceHudMode"><option value="cinematic">CINEMATIC · SPEEDOMETER ONLY</option><option value="race">RACE · COMPACT</option><option value="tactical">TACTICAL · ALL PANELS</option></select><small>Press Y in flight to cycle. Full race data and combat abilities remain accessible through controls.</small></div>
<div class="rl-live-setting"><label for="rlRaceAimAssist">TARGETING ASSIST <input id="rlRaceAimAssist" type="checkbox" checked></label></div>
<div class="rl-live-setting"><label for="rlRaceFlightAssist">FLIGHT ASSIST <input id="rlRaceFlightAssist" type="checkbox" checked></label></div>
<div class="rl-live-setting"><label for="rlRaceMotion">REDUCE UI MOTION <input id="rlRaceMotion" type="checkbox"></label></div>
</div></section>
  
  <div id="rlCountdown" aria-label="Race countdown"></div><div id="rlToast" role="status" aria-live="polite"></div>
  <div id="rlTutorial">MOUSE FLIGHT: Move mouse left/right to choose a direction; the drone curves toward it. Up/down pitches gently and climbs or descends. W/S drive, A/D strafe, Shift boosts. Double-click fires; Esc releases mouse. Fly through the glowing ring.</div>
  <div id="rlCockpitVis" aria-hidden="true"></div><div id="rlMouseUnlock" role="status">MOUSE RELEASED<small>Double-tap or double-click to capture flight · Esc releases</small></div>
 </div>
</div>

