";
const GLB_AB=(()=>{const b=atob(GLB_B64),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u.buffer})();
// Small self-contained GLB reader for the Blender-exported Kestrel (no external dependency).
async function parseGLB(T, url) {
  let buffer = url;
  if (new DataView(buffer).getUint16(0, true) === 0x8b1f) {
    if (typeof DecompressionStream !== 'function') throw new Error('This browser cannot decompress the Port Meridian asset');
    buffer = await new Response(new Blob([buffer]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();
  }
  const view = new DataView(buffer);
  if (view.getUint32(0, true) !== 0x46546c67) throw new Error('Invalid GLB header');
  let offset = 12, doc = null, bin = null;
  while (offset + 8 <= buffer.byteLength) {
    const len = view.getUint32(offset, true), type = view.getUint32(offset + 4, true);
    offset += 8;
    if (type === 0x4e4f534a) doc = JSON.parse(new TextDecoder().decode(new Uint8Array(buffer, offset, len)));
    else if (type === 0x004e4942) bin = buffer.slice(offset, offset + len);
    offset += len;
  }
  if (!doc || !bin) throw new Error('Incomplete GLB');
  const componentTypes = {5120:[1,'getInt8'],5121:[1,'getUint8'],5122:[2,'getInt16'],5123:[2,'getUint16'],5125:[4,'getUint32'],5126:[4,'getFloat32']};
  const componentCounts = {SCALAR:1,VEC2:2,VEC3:3,VEC4:4,MAT2:4,MAT3:9,MAT4:16};
  function accessor(index) {
    const a = doc.accessors[index], bv = doc.bufferViews[a.bufferView], [bytes, method] = componentTypes[a.componentType];
    const n = componentCounts[a.type], stride = bv.byteStride || n * bytes, start = (bv.byteOffset || 0) + (a.byteOffset || 0);
    const data = new DataView(bin), values = new Float32Array(a.count * n);
    for (let i=0;i<a.count;i++) for(let k=0;k<n;k++) {
      let v=data[method](start+i*stride+k*bytes,true);
      if(a.normalized && a.componentType===5121) v/=255;
      if(a.normalized && a.componentType===5123) v/=65535;
      values[i*n+k]=v;
    }
    if (a.type==='SCALAR' && [5121,5123,5125].includes(a.componentType)) {
      const Out = a.componentType===5121?Uint8Array:a.componentType===5123?Uint16Array:Uint32Array;
      return Out.from(values);
    }
    return values;
  }
  // WebKit/Safari can consume excessive memory when createImageBitmap owns
  // many PNG surfaces. Use ordinary image elements for mobile GLB textures;
  // Three.js accepts both image sources without changing their pixels.
  async function decodeModelImage(blob){
    const mobile=(typeof window!=='undefined'&&window.REDLINE_MOBILE);
    if(!mobile&&typeof createImageBitmap==='function'){
      try{return await createImageBitmap(blob)}catch(e){if(typeof Image==='undefined')throw e;}
    }
    if(typeof Image==='undefined'||typeof URL==='undefined'||typeof URL.createObjectURL!=='function'){
      if(typeof createImageBitmap==='function')return createImageBitmap(blob);
      throw new Error('This browser cannot decode the aircraft textures');
    }
    return new Promise((resolve,reject)=>{
      const img=new Image(),url=URL.createObjectURL(blob);
      img.onload=()=>{URL.revokeObjectURL(url);resolve(img)};
      img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('Failed to decode GLB texture'))};
      img.src=url;
    });
  }
  const texturePromises=(doc.textures||[]).map(async t=>{
    const image=doc.images[t.source], bv=doc.bufferViews[image.bufferView], start=bv.byteOffset||0;
    const blob=new Blob([bin.slice(start,start+bv.byteLength)],{type:image.mimeType});
    const source=await decodeModelImage(blob), texture=new T.Texture(source), sampler=doc.samplers?.[t.sampler]||{};
    texture.flipY=false; texture.wrapS=sampler.wrapS===33071?T.ClampToEdgeWrapping:T.RepeatWrapping; texture.wrapT=sampler.wrapT===33071?T.ClampToEdgeWrapping:T.RepeatWrapping;
    texture.magFilter=sampler.magFilter===9728?T.NearestFilter:T.LinearFilter;
    texture.minFilter=sampler.minFilter===9728?T.NearestFilter:sampler.minFilter===9729?T.LinearFilter:T.LinearMipmapLinearFilter;
    texture.generateMipmaps=texture.minFilter===T.LinearMipmapLinearFilter||texture.minFilter===T.NearestMipmapLinearFilter||texture.minFilter===T.NearestMipmapNearestFilter||texture.minFilter===T.LinearMipmapNearestFilter;
    texture.needsUpdate=true; return texture;
  });
  const textures=await Promise.all(texturePromises), tex=info=>info?textures[info.index]:null;
  const materials=(doc.materials||[]).map(m=>{
    const p=m.pbrMetallicRoughness||{}, c=p.baseColorFactor||[1,1,1,1], e=m.emissiveFactor||[0,0,0], mr=tex(p.metallicRoughnessTexture);
    const strength=m.extensions?.KHR_materials_emissive_strength?.emissiveStrength||1;
    const material=new (m.extensions?.KHR_materials_clearcoat || m.extensions?.KHR_materials_transmission ? T.MeshPhysicalMaterial : T.MeshStandardMaterial)({
      color:new T.Color(c[0],c[1],c[2]), opacity:c[3], transparent:m.alphaMode==='BLEND'||c[3]<1,
      alphaTest:m.alphaMode==='MASK'?(m.alphaCutoff??.5):0, depthWrite:m.alphaMode!=='BLEND', metalness:p.metallicFactor??1, roughness:p.roughnessFactor??1,
      map:tex(p.baseColorTexture), normalMap:tex(m.normalTexture), roughnessMap:mr, metalnessMap:mr,
      emissive:new T.Color(e[0],e[1],e[2]), emissiveMap:tex(m.emissiveTexture), emissiveIntensity:strength,
      side:m.doubleSided?T.DoubleSide:T.FrontSide
    });
    if(material.isMeshPhysicalMaterial){
      const cc=m.extensions?.KHR_materials_clearcoat||{}, tr=m.extensions?.KHR_materials_transmission||{};
      material.clearcoat=cc.clearcoatFactor??0;
      material.clearcoatRoughness=cc.clearcoatRoughnessFactor??.2;
      material.transmission=tr.transmissionFactor??0;
      material.thickness=0;
      material.envMapIntensity=1.35;
    }
    material.name=m.name||'';
    if(m.normalTexture?.scale!==undefined)material.normalScale.setScalar(m.normalTexture.scale);
    for(const key of ['map','emissiveMap'])if(material[key])material[key].colorSpace=T.SRGBColorSpace;
    return material;
  });
  const nodes=doc.nodes||[], objects=nodes.map((n,i)=>{
    const o=new T.Group();o.name=`gltf_node_${i}`;o.userData.gltfName=n.name||o.name;
    if(n.matrix){o.matrix.fromArray(n.matrix);o.matrixAutoUpdate=false;}
    else {if(n.translation)o.position.fromArray(n.translation);if(n.rotation)o.quaternion.fromArray(n.rotation);if(n.scale)o.scale.fromArray(n.scale);}
    return o;
  });
  nodes.forEach((n,i)=>{
    if(n.mesh!==undefined){
      const gltfMesh=doc.meshes[n.mesh];
      for(const prim of gltfMesh.primitives||[]){
        if(prim.mode!==undefined && prim.mode!==4) continue;
        const g=new T.BufferGeometry(), attrs=prim.attributes||{};
        if(attrs.POSITION!==undefined)g.setAttribute('position',new T.BufferAttribute(accessor(attrs.POSITION),3));
        if(attrs.NORMAL!==undefined)g.setAttribute('normal',new T.BufferAttribute(accessor(attrs.NORMAL),3));
        if(attrs.TEXCOORD_0!==undefined)g.setAttribute('uv',new T.BufferAttribute(accessor(attrs.TEXCOORD_0),2));
        if(attrs.COLOR_0!==undefined){const ca=doc.accessors[attrs.COLOR_0];g.setAttribute('color',new T.BufferAttribute(accessor(attrs.COLOR_0),componentCounts[ca.type]));}
        if(prim.indices!==undefined)g.setIndex(new T.BufferAttribute(accessor(prim.indices),1));
        if(!g.getAttribute('normal'))g.computeVertexNormals();
        g.computeBoundingSphere();
        const mat=materials[prim.material]||new T.MeshStandardMaterial({color:0xffffff,roughness:.6});
        const mesh=new T.Mesh(g,mat);mesh.name=gltfMesh.name||oName(n,i);mesh.castShadow=true;mesh.receiveShadow=true;objects[i].add(mesh);
      }
    }
    for(const child of n.children||[])objects[i].add(objects[child]);
  });
  function oName(n,i){return n.name||`mesh_${i}`;}
  const scene=new T.Group();scene.name='Kestrel GLB scene';
  for(const i of doc.scenes?.[doc.scene||0]?.nodes||[])scene.add(objects[i]);
  scene.updateMatrixWorld(true);
  const animations=[];
  for(const anim of doc.animations||[]){
    const tracks=[];
    for(const channel of anim.channels||[]){
      const target=channel.target, node=nodes[target.node], object=objects[target.node], sampler=anim.samplers[channel.sampler];
      if(!node||!object)continue;
      const times=accessor(sampler.input), values=accessor(sampler.output), path=target.path;
      const property=path==='rotation'?'quaternion':path==='translation'?'position':path;
      let Track=property==='quaternion'?T.QuaternionKeyframeTrack:T.VectorKeyframeTrack;
      tracks.push(new Track(object.name+'.'+property,times,values));
    }
    if(tracks.length)animations.push(new T.AnimationClip(anim.name||'Kestrel animation',-1,tracks));
  }
  return {scene,animations,materials,document:doc};
}

const clamp = (v, min, max) => Math.max(min, Math.min(max, v));

// Stage 1 adapter: flight is versioned in src/flight/flight-dynamics.js.
const createFlight=()=>window.REDLINE_FLIGHT.createFlight();
const stepFlight=(flight,input,settings,dt)=>window.REDLINE_FLIGHT.stepFlight(flight,input,settings,dt);


